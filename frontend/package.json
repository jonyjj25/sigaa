{
  "name": "frontend",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json --prebundle=false",
    "build": "ng build",
    "configure:android": "node scripts/configure-android-env.mjs",
    "test:android-config": "node --test scripts/configure-android-env.test.mjs",
    "build:android": "npm run configure:android && ng build --configuration android && node scripts/write-android-build-meta.mjs",
    "build:android:dev": "npm run configure:android && ng build --configuration android-development && node scripts/write-android-build-meta.mjs",
    "sync:android": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run sync:android && cd android && gradlew.bat assembleDebug",
    "build:ios": "ng build --configuration ios",
    "sync:ios": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci --browsers=ChromeHeadlessCI --code-coverage",
    "lint": "ng lint",
    "audit:ux": "node scripts/check-ux.mjs",
    "android:release": "node scripts/build-android-release.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/router": "20.3.34",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@ionic/angular": "^8.0.0",
    "angularx-qrcode": "^20.0.0",
    "apexcharts": "^5.15.0",
    "ionicons": "^7.0.0",
    "jspdf": "^4.2.1",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.42",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.34",
    "@angular/language-service": "20.3.34",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~5.9.0",
    "@angular/localize": "20.3.34"
  },
  "description": "An Ionic project"
}
