# Copy these values into your deployment environment; never commit the real values.
# The web container is private by default. Keep loopback unless an institutional
# reverse proxy or VPN requires a specific private-LAN address.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
# Exact peer IP/CIDR of the institutional TLS proxy as seen inside the web container.
# Set the Docker gateway address for a host-local proxy; do not trust every private network.
SIGAA_TRUSTED_PROXIES=replace-with-exact-proxy-peer-cidr
POSTGRES_DB=sigaa
POSTGRES_USER=sigaa_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
APP_DB_PASSWORD=replace-with-a-distinct-runtime-password
BACKUP_DB_PASSWORD=replace-with-a-distinct-backup-password
DB_URL=jdbc:postgresql://localhost:5432/sigaa-database
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_IDENTITY_ATTEMPTS=5
AUTH_RATE_IP_ATTEMPTS=30
AUTH_RATE_BASE_BLOCK_SECONDS=30
APP_TIME_ZONE=America/Panama
QR_PUBLIC_URL=https://your-domain.example
# Solo los orígenes web institucionales que realmente usarán la API.
# Para una misma URL web/API, deje igualmente el origen HTTPS explícito.
CORS_ALLOWED_ORIGINS=https://your-domain.example,https://localhost
# Hosted testing with Mailtrap: copy the SMTP credentials from your Mailtrap sandbox.
# The real .env is ignored by Git; never commit these values.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=replace-with-mailtrap-username
MAIL_PASSWORD=replace-with-mailtrap-password
MAIL_FROM=no-reply@your-domain.example
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set SSL_ENABLED=true only when all SSL_* values are supplied.
SSL_ENABLED=false
SSL_KEYSTORE=file:/secure/path/keystore.p12
SSL_KEYSTORE_PASSWORD=replace-me
SSL_KEY_ALIAS=sigaa
# Paths used by backup generation and Office preview. Use paths valid on the
# deployment operating system.
BACKUP_PG_DUMP=/usr/bin/pg_dump
BACKUP_PG_RESTORE=/usr/bin/pg_restore
BACKUP_DIR=/var/lib/sigaa/backups
# Genere la clave fuera del servidor con:
#   .\ops\scripts\New-BackupEncryptionKey.ps1 -OutputPath E:\custodia\sigaa-backup.key
# o: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-in-base64
BACKUP_AUTOMATIC_ENABLED=true
BACKUP_SCHEDULE_CRON=0 0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COPIES=30
# Debe ser una ruta absoluta de OTRO disco o un recurso NFS/SMB ya montado.
# No use una carpeta del mismo disco que aloja PostgreSQL.
BACKUP_EXTERNAL_DIR_HOST=/mnt/sigaa-backups-external
# Required by docker-compose.prod.yml. Supply legally available Verdana fonts.
SIGAA_FONTS_DIR_HOST=/srv/sigaa-fonts
BACKUP_RESTORE_TEST_ENABLED=true
BACKUP_RESTORE_TEST_CRON=0 0 4 * * SUN
# Copie una plantilla de ops/monitoring como alertmanager.local.yml y complete
# el correo o webhook institucional. El archivo local está ignorado por Git.
ALERTMANAGER_CONFIG_FILE=./ops/monitoring/alertmanager.local.yml
LIBREOFFICE_COMMAND=/usr/bin/soffice
